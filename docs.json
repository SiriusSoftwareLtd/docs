{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Sirius Docs",
  "colors": {
    "primary": "#0088FF",
    "light": "#3399FF",
    "dark": "#0070D6"
  },
  "background": {
    "color": {
      "dark": "#0A0A0B"
    }
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "icons": {
    "library": "lucide"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "family": "Unica77LL",
    "source": "/fonts/Unica77LL-Regular.woff2",
    "format": "woff2",
    "weight": 400
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Home",
        "groups": [
          {
            "group": "Home",
            "pages": [
              "index"
            ]
          }
        ]
      },
      {
        "tab": "Rayfield (2022)",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "rayfield/index"
            ]
          },
          {
            "group": "Getting started",
            "pages": [
              "rayfield/getting-started",
              "rayfield/windows",
              "rayfield/show-rayfield",
              "rayfield/notifications",
              "rayfield/heartbeat"
            ]
          },
          {
            "group": "Elements",
            "pages": [
              "rayfield/elements/interactive",
              "rayfield/elements/keybinds",
              "rayfield/elements/text"
            ]
          },
          {
            "group": "Configuration",
            "pages": [
              "rayfield/themes"
            ]
          },
          {
            "group": "Security",
            "pages": [
              "rayfield/anti-detection",
              "rayfield/secure-mode"
            ]
          }
        ]
      },
      {
        "tab": "Rayfield Gen2",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "rayfield-gen2/index",
              "rayfield-gen2/getting-started",
              "rayfield-gen2/preview",
              "rayfield-gen2/windows",
              "rayfield-gen2/tabs",
              "rayfield-gen2/heartbeat"
            ]
          },
          {
            "group": "Elements",
            "pages": [
              "rayfield-gen2/elements/overview",
              "rayfield-gen2/elements/buttons",
              "rayfield-gen2/elements/toggles",
              "rayfield-gen2/elements/sliders",
              "rayfield-gen2/elements/dropdowns",
              "rayfield-gen2/elements/inputs",
              "rayfield-gen2/elements/keybinds",
              "rayfield-gen2/elements/color-pickers",
              "rayfield-gen2/elements/stats",
              "rayfield-gen2/elements/progress",
              "rayfield-gen2/elements/console",
              "rayfield-gen2/elements/text",
              "rayfield-gen2/elements/dividers"
            ]
          },
          {
            "group": "Feedback",
            "pages": [
              "rayfield-gen2/notifications",
              "rayfield-gen2/popups",
              "rayfield-gen2/tags"
            ]
          },
          {
            "group": "Configuration",
            "pages": [
              "rayfield-gen2/saving",
              "rayfield-gen2/themes",
              "rayfield-gen2/icons",
              "rayfield-gen2/localization"
            ]
          },
          {
            "group": "Security",
            "pages": [
              "rayfield-gen2/secure-mode"
            ]
          }
        ]
      },
      {
        "tab": "RoScripts",
        "groups": [
          {
            "group": "Publish",
            "pages": [
              "roscripts/publish"
            ]
          },
          {
            "group": "API overview",
            "pages": [
              "scripts-api/index"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "scripts-api/authentication",
              "scripts-api/rate-limits",
              "scripts-api/pagination",
              "scripts-api/errors",
              "scripts-api/best-practices",
              "scripts-api/examples",
              "scripts-api/schema"
            ]
          },
          {
            "group": "Endpoints",
            "pages": [
              "scripts-api/endpoints/list",
              "scripts-api/endpoints/search",
              "scripts-api/endpoints/trending",
              "scripts-api/endpoints/get",
              "scripts-api/endpoints/batch",
              "scripts-api/endpoints/games",
              "scripts-api/endpoints/owners",
              "scripts-api/endpoints/misc"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Discord",
          "href": "https://discord.sirius.menu",
          "icon": "discord"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/SiriusSoftwareLtd",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Discord",
      "href": "https://discord.sirius.menu"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/SiriusSoftwareLtd"
    }
  },
  "redirects": [
